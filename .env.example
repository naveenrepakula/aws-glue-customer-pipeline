# Copy this file to .env and replace the bucket with your actual DEV bucket.
AIRFLOW_UID=50000
AWS_PROFILE=default
AWS_DEFAULT_REGION=ap-south-1
AIRFLOW_AWS_CONN_ID=aws_glue_conn

# Example based on the repository's DEV naming convention.
CUSTOMER_DATA_BUCKET=customer-pipeline-dev-<ACCOUNT_ID>-data
CUSTOMER_INPUT_KEY=raw/customers/customers_{{ ds_nodash }}.csv
CUSTOMER_GLUE_JOB_NAME=COADP-Customer-ETL-DEV
CUSTOMER_TRIGGER_LAMBDA=customer-pipeline-dev-trigger-glue
CUSTOMER_GLUE_CRAWLER_NAME=customer-pipeline-dev-customer-crawler
MAX_REJECTION_PERCENTAGE=30
